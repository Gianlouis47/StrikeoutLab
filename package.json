{
  "name": "strikeoutlab",
  "private": true,
  "version": "0.1.0",
  "description": "StrikeoutLab: sistema determinista de análisis de props de ponches MLB, con Supabase + IA.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "npm run test --workspace packages/core",
    "build": "npm run build --workspace packages/core",
    "postinstall": "npm run build --workspace packages/core",
    "web": "npm run dev --workspace apps/web",
    "web:build": "npm run build --workspace apps/web"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "react-native-reanimated": "4.5.0",
    "react-native-worklets": "0.10.4"
  }
}
