# Las variables del build de producción, versionadas a propósito.
#
# Vite mete las VITE_* adentro del bundle EN TIEMPO DE BUILD, así que Vercel
# las necesita para compilar. Están acá en vez de en el dashboard de Vercel
# para que un deploy funcione sin que nadie tenga que ir a configurar nada.
#
# POR QUÉ NO ES UN SECRETO FILTRADO:
#
# La clave publishable de Supabase está DISEÑADA para ir en el navegador. Ya
# viaja dentro del JavaScript que se descarga cualquiera que abra la app, así
# que tenerla acá no la expone más de lo que ya está. Lo que protege los datos
# no es esconderla, es el RLS: la lista blanca de usuarios_permitidos. Estar
# registrado no alcanza para leer ni escribir nada.
#
# LO QUE NUNCA VA ACÁ: la service_role key. Esa sí pasa por encima del RLS y
# vive solo en las variables de la Edge Function, del lado del servidor.

VITE_SUPABASE_URL=https://xuebtkafypivqygyqgcv.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_NkfVuFVi-Ars9v0-tPlWiw_H-Ad8vaN
